# FairShift Environment Configuration
# UN SDG 8: Decent Work and Economic Growth

# Google Gemini API Key (Required for live Gemini 2.5 Flash model)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred model selection (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Server port (defaults to 8080 for Google Cloud Run)
PORT=8080
